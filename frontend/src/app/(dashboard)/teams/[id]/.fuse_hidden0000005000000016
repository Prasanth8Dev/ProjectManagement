'use client';
import { useState } from 'react';
import { useParams } from 'next/navigation';
import { motion } from 'framer-motion';
import Link from 'next/link';
import { Users, FolderKanban, Plus, Unlink } from 'lucide-react';
import { useTeam, useLinkProjectToTeam, useUnlinkProjectFromTeam } from '@/hooks/use-teams';
import { useProjects } from '@/hooks/use-projects';
import { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card';
import { Button } from '@/components/ui/button';
import { Avatar, AvatarFallback, AvatarImage } from '@/components/ui/avatar';
import { Badge } from '@/components/ui/badge';
import { Skeleton } from '@/components/ui/skeleton';
import { ErrorState } from '@/components/ui/error-state';
import { ActivityFeed } from '@/components/features/activity/activity-feed';
import {
  Dialog,
  DialogContent,
  DialogHeader,
  DialogTitle,
  DialogFooter,
} from '@/components/ui/dialog';
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from '@/components/ui/select';
import { useToast } from '@/hooks/use-toast';
import { ROUTES } from '@/constants/routes';

export default function TeamOverviewPage() {
  const { id } = useParams<{ id: string }>();
  const { toast } = useToast();
  const { data: teamResp, isLoading, isError } = useTeam(id);
  const team = (teamResp as any)?.data ?? teamResp;

  const { data: projectsResp } = useProjects({ limit: 100 });
  const allProjects = projectsResp?.data ?? [];

  const linkProject = useLinkProjectToTeam(id);
  const unlinkProject = useUnlinkProjectFromTeam(id);

  const [linkDialogOpen, setLinkDialogOpen] = useState(false);
  const [selectedProjectId, setSelectedProjectId] = useState('');

  // Linked project IDs for filtering dropdown
  const linkedProjectIds = new Set(
    (team?.projects ?? []).map((p: any) => p.projectId ?? p.project?.id)
  );

  const availableProjects = (allProjects as any[]).filter(
    (p: any) => !linkedProjectIds.has(p.id)
  );

  const handleLink = async () => {
    if (!selectedProjectId) return;
    try {
      await linkProject.mutateAsync(selectedProjectId);
      toast({ title: 'Project linked to team' });
      setLinkDialogOpen(false);
      setSelectedProjectId('');
    } catch {
      toast({ variant: 'destructive', title: 'Failed to link project' });
    }
  };

  const handleUnlink = async (projectId: string) => {
    try {
      await unlinkProject.mutateAsync(projectId);
      toast({ title: 'Project unlinked' });
    } catch {
      toast({ variant: 'destructive', title: 'Failed to unlink project' });
    }
  };

  if (isError) {
    return <ErrorState title="Failed to load team" description="Please try again." />;
  }

  return (
    <motion.div
      initial={{ opacity: 0, y: 20 }}
      animate={{ opacity: 1, y: 0 }}
      className="space-y-6"
    >
      {/* Header */}
      {isLoading ? (
        <div className="space-y-2">
          <Skeleton className="h-8 w-1/3" />
          <Skeleton className="h-4 w-1/2" />
        </div>
      ) : (
        <div className="flex items-start gap-4">
          <div
            className="w-12 h-12 rounded-xl flex-shrink-0"
            style={{ backgroundColor: team?.color || '#6366f1' }}
          />
          <div className="flex-1">
            <h1 className="text-2xl font-bold">{team?.name}</h1>
            {team?.description && (
              <p className="text-muted-foreground mt-1">{team.description}</p>
            )}
            <p className="text-sm text-muted-foreground mt-2">
              {team?.members?.length ?? 0} member{(team?.members?.length ?? 0) !== 1 ? 's' : ''}
            </p>
          </div>
        </div>
      )}

      <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
        {/* Projects */}
        <div className="lg:col-span-2 space-y-6">
          <Card>
            <CardHeader>
              <div className="flex items-center justify-between">
                <CardTitle className="text-base flex items-center gap-2">
                  <FolderKanban className="w-4 h-4" />
                  Active Projects
                </CardTitle>
                <Button
                  size="sm"
                  variant="outline"
                  onClick={() => setLinkDialogOpen(true)}
                >
                  <Plus className="w-3.5 h-3.5 mr-1.5" />
                  Link Project
                </Button>
              </div>
            </CardHeader>
            <CardContent>
              {isLoading ? (
                <div className="space-y-3">
                  {Array.from({ length: 3 }).map((_, i) => (
                    <Skeleton key={i} className="h-12 w-full" />
                  ))}
                </div>
              ) : (team?.projects?.length ?? 0) === 0 ? (
                <div className="text-center py-6">
                  <p className="text-sm text-muted-foreground mb-3">No projects linked to this team.</p>
                  <Button size="sm" variant="outline" onClick={() => setLinkDialogOpen(true)}>
                    <Plus className="w-3.5 h-3.5 mr-1.5" />
                    Link a Project
                  </Button>
                </div>
              ) : (
                <ul className="space-y-2">
                  {team?.projects?.map((pt: any) => {
                    // Data shape: { projectId, teamId, project: { id, name, status, color } }
                    const p = pt.project ?? pt;
                    const projectId = pt.projectId ?? p.id;
                    return (
                      <li key={projectId} className="flex items-center gap-2 group">
                        <Link
                          href={ROUTES.PROJECT(p.id)}
                          className="flex-1 flex items-center gap-3 p-2 rounded-lg hover:bg-muted/50 transition-colors"
                        >
                          <div
                            className="w-3 h-3 rounded-full flex-shrink-0"
                            style={{ backgroundColor: p.color || '#6366f1' }}
                          />
                          <span className="font-medium text-sm">{p.name}</span>
                          <Badge variant="outline" className="ml-auto text-xs">
                            {p.status?.replace(/_/g, ' ')}
                          </Badge>
                        </Link>
                        <Button
                          variant="ghost"
                          size="icon"
                          className="h-7 w-7 opacity-0 group-hover:opacity-100 text-muted-foreground hover:text-destructive"
                          onClick={() => handleUnlink(projectId)}
                          title="Unlink project"
                        >
                          <Unlink className="w-3.5 h-3.5" />
                        </Button>
                      </li>
                    );
                  })}
                </ul>
              )}
            </CardContent>
          </Card>

          {/* Activity */}
          <Card>
            <CardHeader>
              <CardTitle className="text-base">Recent Activity</CardTitle>
            </CardHeader>
            <CardContent>
              <ActivityFeed teamId={id} limit={8} />
            </CardContent>
          </Card>
        </div>

        {/* Members sidebar */}
        <div>
          <Card>
            <CardHeader>
              <div className="flex items-center justify-between">
                <CardTitle className="text-base flex items-center gap-2">
                  <Users className="w-4 h-4" />
                  Members
                </CardTitle>
                <Button variant="ghost" size="sm" asChild>
                  <Link href={ROUTES.TEAM_MEMBERS(id)}>View all</Link>
                </Button>
              </div>
            </CardHeader>
            <CardContent>
              {isLoading ? (
                <div className="space-y-3">
                  {Array.from({ length: 4 }).map((_, i) => (
                    <div key={i} className="flex items-center gap-3">
                      <Skeleton className="w-9 h-9 rounded-full" />
                      <Skeleton className="h-4 w-24" />
                    </div>
                  ))}
                </div>
              ) : (team?.members?.length ?? 0) === 0 ? (
                <p className="text-sm text-muted-foreground">No members yet.</p>
              ) : (
                <ul className="space-y-3">
                  {team?.members?.slice(0, 5).map((m: any) => (
                    <li key={m.id} className="flex items-center gap-3">
                      <Avatar className="w-9 h-9">
                        <AvatarImage src={m.user?.avatar} alt={m.user?.name} />
                        <AvatarFallback className="text-xs">
                          {(m.user?.name ?? 'U').charAt(0).toUpperCase()}
                        </AvatarFallback>
                      </Avatar>
                      <div className="min-w-0">
                        <p className="text-sm font-medium truncate">{m.user?.name}</p>
                        <p className="text-xs text-muted-foreground">{m.role}</p>
                      </div>
                    </li>
                  ))}
                  {(team?.members?.length ?? 0) > 5 && (
                    <li>
                      <Button variant="ghost" size="sm" asChild className="w-full">
                        <Link href={ROUTES.TEAM_MEMBERS(id)}>
                          +{(team?.members?.length ?? 0) - 5} more
                        </Link>
                      </Button>
                    </li>
                  )}
                </ul>
              )}
            </CardContent>
          </Card>
        </div>
      </div>

      {/* Link Project Dialog */}
      <Dialog open={linkDialogOpen} onOpenChange={setLinkDialogOpen}>
        <DialogContent className="sm:max-w-sm">
          <DialogHeader>
            <DialogTitle>Link Project to Team</DialogTitle>
          </DialogHeader>
          <div className="py-2">
            <Select value={selectedProjectId} onValueChange={setSelectedProjectId}>
              <SelectTrigger>
                <SelectValue placeholder="Select a project" />
              </SelectTrigger>
              <SelectContent>
                {availableProjects.length === 0 ? (
                  <div className="px-3 py-2 text-sm text-muted-foreground">
                    All projects are already linked
                  </div>
                ) : (
                  (availableProjects as any[]).map((p: any) => (
                    <SelectItem key={p.id} value={p.id}>
                      {p.name}
                    </SelectItem>
                  ))
                )}
              </SelectContent>
            </Select>
          </div>
          <DialogFooter>
            <Button variant="outline" onClick={() => setLinkDialogOpen(false)}>
              Cancel
            </Button>
            <Button
              onClick={handleLink}
              disabled={!selectedProjectId || linkProject.isPending}
            >
              {linkProject.isPending ? 'Linking...' : 'Link Project'}
            </Button>
          </DialogFooter>
        </DialogContent>
      </Dialog>
    </motion.div>
  );
}
