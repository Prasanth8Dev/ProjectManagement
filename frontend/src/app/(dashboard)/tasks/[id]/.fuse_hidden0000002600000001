'use client';
import { useState } from 'react';
import { useParams } from 'next/navigation';
import { motion } from 'framer-motion';
import { Skeleton } from '@/components/ui/skeleton';
import { ErrorState } from '@/components/ui/error-state';
import { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card';
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from '@/components/ui/select';
import { Input } from '@/components/ui/input';
import { Textarea } from '@/components/ui/textarea';
import { Badge } from '@/components/ui/badge';
import { Button } from '@/components/ui/button';
import { Collapsible, CollapsibleContent, CollapsibleTrigger } from '@/components/ui/collapsible';
import { ChevronDown } from 'lucide-react';
import { useTask, useUpdateTask } from '@/hooks/use-tasks';
import { useMembers } from '@/hooks/use-members';
import { useMilestones } from '@/hooks/use-milestones';
import { TaskChecklist } from '@/components/features/tasks/task-checklist';
import { TaskSubtasks } from '@/components/features/tasks/task-subtasks';
import { TaskAttachments } from '@/components/features/tasks/task-attachments';
import { TaskComments } from '@/components/features/tasks/task-comments';
import { TaskHistory } from '@/components/features/tasks/task-history';
import { useToast } from '@/hooks/use-toast';
import { extractApiError } from '@/lib/utils/error';
import { TASK_STATUS_CONFIG } from '@/constants/task-statuses';
import { TASK_PRIORITY_CONFIG } from '@/constants/priorities';
import { Avatar, AvatarFallback, AvatarImage } from '@/components/ui/avatar';

const STATUS_OPTIONS = Object.entries(TASK_STATUS_CONFIG).map(([value, cfg]) => ({
  value,
  label: (cfg as any).label,
}));

const PRIORITY_OPTIONS = Object.entries(TASK_PRIORITY_CONFIG).map(([value, cfg]) => ({
  value,
  label: (cfg as any).label,
}));

function InlineEditTitle({
  value,
  onSave,
}: {
  value: string;
  onSave: (v: string) => void;
}) {
  const [editing, setEditing] = useState(false);
  const [draft, setDraft] = useState(value);

  if (editing) {
    return (
      <input
        autoFocus
        className="text-2xl font-bold w-full bg-transparent border-b-2 border-primary outline-none pb-1"
        value={draft}
        onChange={(e) => setDraft(e.target.value)}
        onBlur={() => {
          setEditing(false);
          if (draft.trim() && draft !== value) onSave(draft.trim());
        }}
        onKeyDown={(e) => {
          if (e.key === 'Enter') {
            setEditing(false);
            if (draft.trim() && draft !== value) onSave(draft.trim());
          }
          if (e.key === 'Escape') {
            setDraft(value);
            setEditing(false);
          }
        }}
      />
    );
  }

  return (
    <h1
      className="text-2xl font-bold cursor-pointer hover:text-primary/80 transition-colors"
      onClick={() => setEditing(true)}
      title="Click to edit"
    >
      {value}
    </h1>
  );
}

function InlineEditDescription({
  value,
  onSave,
}: {
  value: string;
  onSave: (v: string) => void;
}) {
  const [editing, setEditing] = useState(false);
  const [draft, setDraft] = useState(value);

  if (editing) {
    return (
      <div>
        <Textarea
          autoFocus
          rows={5}
          value={draft}
          onChange={(e) => setDraft(e.target.value)}
          className="resize-none"
        />
        <div className="flex gap-2 mt-2">
          <Button
            size="sm"
            onClick={() => {
              setEditing(false);
              if (draft !== value) onSave(draft);
            }}
          >
            Save
          </Button>
          <Button
            size="sm"
            variant="outline"
            onClick={() => {
              setDraft(value);
              setEditing(false);
            }}
          >
            Cancel
          </Button>
        </div>
      </div>
    );
  }

  return (
    <p
      className="text-muted-foreground cursor-pointer hover:text-foreground min-h-[2rem] rounded p-1 -m-1 hover:bg-muted/50 transition-colors"
      onClick={() => setEditing(true)}
      title="Click to edit"
    >
      {value || <em>No description. Click to add one.</em>}
    </p>
  );
}

export default function TaskDetailPage() {
  const { id } = useParams<{ id: string }>();
  const { toast } = useToast();
  const { data: taskResp, isLoading, isError } = useTask(id);
  const { data: membersResp } = useMembers();
  const updateTask = useUpdateTask(id);

  const task = taskResp?.data;
  const members = membersResp?.data ?? [];

  const projectId = task?.projectId ?? task?.project?.id;
  const { data: milestonesResp } = useMilestones(projectId ?? '');
  const milestones = milestonesResp?.data ?? [];

  const update = async (patch: Record<string, unknown>) => {
    try {
      await updateTask.mutateAsync(patch);
    } catch (err) {
      toast({ variant: 'destructive', title: 'Error', description: extractApiError(err) });
    }
  };

  if (isError) {
    return <ErrorState title="Failed to load task" description="Please try again." />;
  }

  if (isLoading) {
    return (
      <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div className="lg:col-span-2 space-y-4">
          <Skeleton className="h-10 w-3/4" />
          <Skeleton className="h-32 w-full" />
          <Skeleton className="h-48 w-full" />
        </div>
        <div className="space-y-4">
          {Array.from({ length: 6 }).map((_, i) => (
            <Skeleton key={i} className="h-10 w-full" />
          ))}
        </div>
      </div>
    );
  }

  return (
    <motion.div
      initial={{ opacity: 0, y: 20 }}
      animate={{ opacity: 1, y: 0 }}
      className="grid grid-cols-1 lg:grid-cols-3 gap-6"
    >
      {/* Left column */}
      <div className="lg:col-span-2 space-y-6">
        <Card>
          <CardContent className="pt-6 space-y-4">
            <InlineEditTitle
              value={task?.title ?? ''}
              onSave={(title) => update({ title })}
            />
            <InlineEditDescription
              value={task?.description ?? ''}
              onSave={(description) => update({ description })}
            />
          </CardContent>
        </Card>

        <TaskChecklist taskId={id} />
        <TaskSubtasks taskId={id} projectId={projectId ?? ''} />
        <TaskAttachments taskId={id} />
        <TaskComments taskId={id} />
      </div>

      {/* Right column */}
      <div className="space-y-4">
        <Card>
          <CardContent className="pt-6 space-y-5">
            {/* Status */}
            <div>
              <p className="text-xs font-semibold text-muted-foreground uppercase tracking-wide mb-1.5">
                Status
              </p>
              <Select
                value={task?.status}
                onValueChange={(status) => update({ status })}
              >
                <SelectTrigger>
                  <SelectValue />
                </SelectTrigger>
                <SelectContent>
                  {STATUS_OPTIONS.map((o) => (
                    <SelectItem key={o.value} value={o.value}>
                      {o.label}
                    </SelectItem>
                  ))}
                </SelectContent>
              </Select>
            </div>

            {/* Priority */}
            <div>
              <p className="text-xs font-semibold text-muted-foreground uppercase tracking-wide mb-1.5">
                Priority
              </p>
              <Select
                value={task?.priority}
                onValueChange={(priority) => update({ priority })}
              >
                <SelectTrigger>
                  <SelectValue />
                </SelectTrigger>
                <SelectContent>
                  {PRIORITY_OPTIONS.map((o) => (
                    <SelectItem key={o.value} value={o.value}>
                      {o.label}
                    </SelectItem>
                  ))}
                </SelectContent>
              </Select>
            </div>

            {/* Assignee */}
            <div>
              <p className="text-xs font-semibold text-muted-foreground uppercase tracking-wide mb-1.5">
                Assignee
              </p>
              <Select
                value={task?.assigneeId ?? task?.assignee?.id ?? ''}
                onValueChange={(assigneeId) => update({ assigneeId: assigneeId || null })}
              >
                <SelectTrigger>
                  <SelectValue placeholder="Unassigned" />
                </SelectTrigger>
                <SelectContent>
                  <SelectItem value="">Unassigned</SelectItem>
                  {members.map((m: any) => (
                    <SelectItem key={m.id} value={m.id}>
                      <div className="flex items-center gap-2">
                        <Avatar className="w-5 h-5">
                          <AvatarImage src={m.avatar} />
                          <AvatarFallback className="text-xs">
                            {m.name.charAt(0)}
                          </AvatarFallback>
                        </Avatar>
                        {m.name}
                      </div>
                    </SelectItem>
                  ))}
                </SelectContent>
              </Select>
            </div>

            {/* Reporter (read-only) */}
            {task?.reporter && (
              <div>
                <p className="text-xs font-semibold text-muted-foreground uppercase tracking-wide mb-1.5">
                  Reporter
                </p>
                <div className="flex items-center gap-2 text-sm">
                  <Avatar className="w-6 h-6">
                    <AvatarImage src={task.reporter.avatar} />
                    <AvatarFallback className="text-xs">
                      {task.reporter.name?.charAt(0)}
                    </AvatarFallback>
                  </Avatar>
                  {task.reporter.name}
                </div>
              </div>
            )}

            {/* Project (read-only) */}
            {task?.project && (
              <div>
                <p className="text-xs font-semibold text-muted-foreground uppercase tracking-wide mb-1.5">
                  Project
                </p>
                <div className="flex items-center gap-2 text-sm">
                  <div
                    className="w-3 h-3 rounded-full"
                    style={{ backgroundColor: task.project.color || '#6366f1' }}
                  />
                  {task.project.name}
                </div>
              </div>
            )}

            {/* Milestone */}
            <div>
              <p className="text-xs font-semibold text-muted-foreground uppercase tracking-wide mb-1.5">
                Milestone
              </p>
              <Select
                value={task?.milestoneId ?? task?.milestone?.id ?? ''}
                onValueChange={(milestoneId) => update({ milestoneId: milestoneId || null })}
              >
                <SelectTrigger>
                  <SelectValue placeholder="None" />
                </SelectTrigger>
                <SelectContent>
                  <SelectItem value="">None</SelectItem>
                  {milestones.map((m: any) => (
                    <SelectItem key={m.id} value={m.id}>
                      {m.name}
                    </SelectItem>
                  ))}
                </SelectContent>
              </Select>
            </div>

            {/* Start Date */}
            <div>
              <p className="text-xs font-semibold text-muted-foreground uppercase tracking-wide mb-1.5">
                Start Date
              </p>
              <Input
                type="date"
                value={task?.startDate ? task.startDate.split('T')[0] : ''}
                onChange={(e) => update({ startDate: e.target.value || null })}
              />
            </div>

            {/* Due Date */}
            <div>
              <p className="text-xs font-semibold text-muted-foreground uppercase tracking-wide mb-1.5">
                Due Date
              </p>
              <Input
                type="date"
                value={task?.dueDate ? task.dueDate.split('T')[0] : ''}
                onChange={(e) => update({ dueDate: e.target.value || null })}
              />
            </div>

            {/* Estimated Hours */}
            <div>
              <p className="text-xs font-semibold text-muted-foreground uppercase tracking-wide mb-1.5">
                Estimated Hours
              </p>
              <Input
                type="number"
                min={0}
                step={0.5}
                value={task?.estimatedHours ?? ''}
                onChange={(e) =>
                  update({ estimatedHours: e.target.value ? parseFloat(e.target.value) : null })
                }
                placeholder="0"
              />
            </div>
          </CardContent>
        </Card>

        {/* Task History (collapsible) */}
        <Collapsible>
          <Card>
            <CardHeader className="py-3">
              <CollapsibleTrigger className="flex items-center justify-between w-full text-sm font-semibold">
                History
                <ChevronDown className="w-4 h-4 text-muted-foreground" />
              </CollapsibleTrigger>
            </CardHeader>
            <CollapsibleContent>
              <CardContent className="pt-0">
                <TaskHistory taskId={id} />
              </CardContent>
            </CollapsibleContent>
          </Card>
        </Collapsible>
      </div>
    </motion.div>
  );
}
