// =============================================================================
// Team & Project Management — Complete Prisma Schema
// Phase 1 · PostgreSQL · Prisma ORM
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum UserRole {
  ADMIN
  MANAGER
  PROJECT_MANAGER
  DEVELOPER
  VIEWER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  INVITED
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
  CANCELLED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  TESTING
  DONE
  CLOSED
  CANCELLED
}

// Fine-grained lifecycle event types for the immutable TaskActivity log.
// Distinct from the coarse Kanban `TaskStatus` above — a task can be
// IN_PROGRESS and separately paused/blocked without changing its status.
enum TaskEventType {
  TASK_CREATED
  TASK_ASSIGNED
  TASK_REASSIGNED
  TASK_STARTED
  TASK_PAUSED
  TASK_RESUMED
  TASK_BLOCKED
  TASK_UNBLOCKED
  TASK_COMPLETED
  REVIEW_STARTED
  REVIEW_COMPLETED
  TASK_CLOSED
  COMMENT_ADDED
  STATUS_CHANGED
  PRIORITY_CHANGED
  ETA_CHANGED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  MISSED
}

enum TeamMemberRole {
  LEAD
  MEMBER
}

enum ProjectMemberRole {
  OWNER
  MANAGER
  DEVELOPER
  VIEWER
}

enum ActivityAction {
  CREATED
  UPDATED
  DELETED
  ASSIGNED
  REASSIGNED
  COMMENTED
  STATUS_CHANGED
  PRIORITY_CHANGED
  DUE_DATE_CHANGED
  MEMBER_ADDED
  MEMBER_REMOVED
  ATTACHMENT_ADDED
  ATTACHMENT_REMOVED
  CHECKLIST_CHECKED
  CHECKLIST_UNCHECKED
  SUBTASK_COMPLETED
  MILESTONE_REACHED
  ARCHIVED
  UNARCHIVED
}

enum AttachmentEntityType {
  TASK
  PROJECT
  COMMENT
  DAILY_UPDATE
}

enum BugStatus {
  OPEN
  IN_PROGRESS
  PENDING
  IN_REVIEW
  TESTING
  RESOLVED
  REOPENED
  CLOSED
  WONT_FIX
}

enum BugSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BugPlatform {
  IOS
  ANDROID
  BACKEND
  FRONTEND
}

// =============================================================================
// USER
// =============================================================================

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  name         String
  avatar       String?
  role         UserRole   @default(DEVELOPER)
  status       UserStatus @default(ACTIVE)
  jobTitle     String?
  department   String?
  phone        String?
  timezone     String?    @default("UTC")
  bio          String?
  password     String?    // plain-text password (dev mode)

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  teamMemberships   TeamMember[]
  projectMemberships ProjectMember[]
  assignedTasks     Task[]            @relation("TaskAssignee")
  reportedTasks     Task[]            @relation("TaskReporter")
  comments          Comment[]
  attachments       Attachment[]
  dailyUpdates      DailyWorkUpdate[]
  dailyUpdateReplies DailyWorkUpdateReply[]
  activityLogs      ActivityLog[]
  taskActivities    TaskActivity[]
  bugHistories      BugHistory[]
  assignedBugs      Bug[]             @relation("BugAssignee")
  reportedBugs      Bug[]             @relation("BugReporter")
  notifications         Notification[]    @relation("NotificationRecipient")
  triggeredNotifications Notification[]   @relation("NotificationActor")
  interventionsReceived Intervention[]    @relation("InterventionEmployee")
  interventionsLogged   Intervention[]    @relation("InterventionManager")
  organizedMeetings     Meeting[]         @relation("MeetingOrganizer")
  meetingParticipations MeetingParticipant[]
  assignedActionItems   MeetingActionItem[] @relation("ActionItemAssignee")

  @@index([email])
  @@index([role])
  @@index([status])
  @@map("users")
}

// =============================================================================
// TEAM
// =============================================================================

model Team {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  avatar      String?
  color       String?  @default("#6366f1")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  members     TeamMember[]
  projects    ProjectTeam[]

  @@index([slug])
  @@map("teams")
}

model TeamMember {
  id        String         @id @default(uuid())
  teamId    String
  userId    String
  role      TeamMemberRole @default(MEMBER)
  joinedAt  DateTime       @default(now())

  team      Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@map("team_members")
}

// =============================================================================
// PROJECT
// =============================================================================

model Project {
  id          String          @id @default(uuid())
  name        String
  slug        String          @unique
  description String?
  status      ProjectStatus   @default(PLANNING)
  priority    ProjectPriority @default(MEDIUM)
  color       String?         @default("#6366f1")
  icon        String?
  startDate   DateTime?
  endDate     DateTime?
  isArchived  Boolean         @default(false)
  archivedAt  DateTime?

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Relations
  members     ProjectMember[]
  teams       ProjectTeam[]
  tasks       Task[]
  milestones  Milestone[]
  labels      Label[]
  attachments Attachment[]
  activityLogs ActivityLog[]
  dailyUpdates DailyWorkUpdateProject[]
  bugs        Bug[]
  meetings    Meeting[]

  @@index([slug])
  @@index([status])
  @@index([isArchived])
  @@index([startDate, endDate])
  @@map("projects")
}

model ProjectMember {
  id        String            @id @default(uuid())
  projectId String
  userId    String
  role      ProjectMemberRole @default(DEVELOPER)
  joinedAt  DateTime          @default(now())

  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("project_members")
}

model ProjectTeam {
  id        String   @id @default(uuid())
  projectId String
  teamId    String
  addedAt   DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([projectId, teamId])
  @@index([projectId])
  @@index([teamId])
  @@map("project_teams")
}

// =============================================================================
// MILESTONE
// =============================================================================

model Milestone {
  id          String          @id @default(uuid())
  projectId   String
  name        String
  description String?
  status      MilestoneStatus @default(PENDING)
  dueDate     DateTime
  completedAt DateTime?

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks       Task[]

  @@index([projectId])
  @@index([status])
  @@index([dueDate])
  @@map("milestones")
}

// =============================================================================
// LABEL
// =============================================================================

model Label {
  id        String   @id @default(uuid())
  projectId String
  name      String
  color     String   @default("#6366f1")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     TaskLabel[]

  @@unique([projectId, name])
  @@index([projectId])
  @@map("labels")
}

model TaskLabel {
  taskId  String
  labelId String

  task    Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label   Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@map("task_labels")
}

// =============================================================================
// TASK
// =============================================================================

model Task {
  id             String       @id @default(uuid())
  projectId      String
  milestoneId    String?
  assigneeId     String?
  reporterId     String?
  parentTaskId   String?      // null = top-level task

  title          String
  description    String?
  status         TaskStatus   @default(BACKLOG)
  priority       TaskPriority @default(MEDIUM)

  startDate      DateTime?
  dueDate        DateTime?     // also used as the task's ETA
  assignedAt     DateTime?     // set the first time an assignee is attached
  startedAt      DateTime?     // set when work actually begins (Start Task)
  completedAt    DateTime?
  estimatedHours Float?
  actualHours    Float?

  // Lifecycle flags — independent of `status` so a task can be paused or
  // blocked while remaining IN_PROGRESS on the Kanban board.
  isPaused       Boolean      @default(false)
  isBlocked      Boolean      @default(false)
  blockedReason  String?

  position       Int          @default(0) // Kanban ordering within column
  isArchived     Boolean      @default(false)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relations
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone      Milestone?   @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  assignee       User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporter       User?        @relation("TaskReporter", fields: [reporterId], references: [id], onDelete: SetNull)

  // Self-referential: subtasks
  parentTask     Task?        @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks       Task[]       @relation("TaskSubtasks")

  labels         TaskLabel[]
  comments       Comment[]
  attachments    Attachment[]
  checklistItems ChecklistItem[]
  activityEvents TaskActivity[]
  activityLogs   ActivityLog[]
  dailyUpdateTasks DailyWorkUpdateTask[]
  linkedBugs     Bug[]           @relation("BugLinkedTask")
  interventions  Intervention[]
  linkedActionItem MeetingActionItem? @relation("ActionItemTask")

  @@index([projectId])
  @@index([assigneeId])
  @@index([reporterId])
  @@index([milestoneId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([parentTaskId])
  @@index([projectId, status, position]) // Kanban board fetch
  @@map("tasks")
}

// =============================================================================
// CHECKLIST ITEM
// =============================================================================

model ChecklistItem {
  id          String   @id @default(uuid())
  taskId      String
  title       String
  isCompleted Boolean  @default(false)
  position    Int      @default(0)
  completedAt DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("checklist_items")
}

// =============================================================================
// COMMENT
// =============================================================================

model Comment {
  id           String    @id @default(uuid())
  taskId       String?   // set when commenting on a Task
  bugId        String?   // set when commenting on a Bug
  actionItemId String?   // set when commenting on a Meeting action item
  authorId     String
  parentId  String?   // null = top-level comment; set = reply

  content   String
  mentions  String[]  // Array of user IDs mentioned (@username)
  isEdited  Boolean   @default(false)
  editedAt  DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  task       Task?              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  bug        Bug?               @relation(fields: [bugId], references: [id], onDelete: Cascade)
  actionItem MeetingActionItem? @relation(fields: [actionItemId], references: [id], onDelete: Cascade)
  author     User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent     Comment?           @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    Comment[]          @relation("CommentReplies")

  @@index([taskId])
  @@index([bugId])
  @@index([actionItemId])
  @@index([authorId])
  @@index([parentId])
  @@map("comments")
}

// =============================================================================
// ATTACHMENT
// =============================================================================

model Attachment {
  id         String               @id @default(uuid())
  uploadedBy String
  projectId  String?
  taskId     String?

  fileName   String               // Original file name
  fileKey    String               @unique // Storage key (local path or S3 key)
  fileUrl    String               // Access URL
  mimeType   String
  fileSize   Int                  // Bytes
  entityType AttachmentEntityType

  createdAt  DateTime             @default(now())

  uploader   User                 @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)
  project    Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task       Task?                @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([projectId])
  @@index([uploadedBy])
  @@map("attachments")
}

// =============================================================================
// TASK HISTORY
// =============================================================================

// Immutable event log for a task's full lifecycle (assignment, start/pause/
// block/review/complete/close, plus field changes and comments). Never
// updated or deleted after creation — a correction is a new event, not an
// edit to history. Time-tracking durations (active/paused/blocked/review
// time) are derived from this table on read, never stored.
model TaskActivity {
  id            String        @id @default(uuid())
  taskId        String
  userId        String?       // null = system/automated action, no actor context

  eventType     TaskEventType

  previousValue String?
  newValue      String?
  reason        String?       // e.g. why a task was paused/blocked
  comment       String?

  createdAt     DateTime      @default(now())

  task          Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([userId])
  @@index([eventType])
  @@index([createdAt])
  @@map("task_activity")
}

model BugHistory {
  id        String   @id @default(uuid())
  bugId     String
  userId    String

  field     String   // "status", "assignee", etc.
  oldValue  String?
  newValue  String?

  createdAt DateTime @default(now())

  bug       Bug      @relation(fields: [bugId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([bugId])
  @@index([userId])
  @@index([createdAt])
  @@map("bug_history")
}

// =============================================================================
// ACTIVITY LOG
// =============================================================================

model ActivityLog {
  id          String         @id @default(uuid())
  userId      String
  projectId   String?
  taskId      String?

  action      ActivityAction
  entityType  String         // "Task", "Project", "Comment", etc.
  entityId    String
  entityTitle String?        // Snapshot of title at time of action
  metadata    Json?          // Extra context (old→new values, etc.)

  createdAt   DateTime       @default(now())

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task        Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([projectId])
  @@index([taskId])
  @@index([action])
  @@index([createdAt])
  @@index([entityType, entityId])
  @@map("activity_logs")
}

// =============================================================================
// NOTIFICATION
// =============================================================================

enum NotificationType {
  MENTION
  TASK_ASSIGNED
  BUG_ASSIGNED
  TASK_COMMENT
  BUG_COMMENT
  BUG_LINKED_TO_TASK
  INTERVENTION_LOGGED
  TASK_BLOCKED
  TASK_UNBLOCKED
  TASK_ETA_APPROACHING
  TASK_OVERDUE
  TASK_COMPLETED
  REVIEW_REQUESTED
  MOM_ACTION_ITEM_ASSIGNED
  MOM_ACTION_ITEM_DUE_SOON
  DAILY_UPDATE_REPLY
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           // recipient
  actorId   String?          // who triggered it (null for system-generated)

  type      NotificationType
  title     String
  message   String?
  link      String?          // frontend route to deep-link to, e.g. "/tasks/:id"

  taskId    String?
  bugId     String?
  commentId String?
  meetingId String?
  actionItemId String?
  dailyUpdateId String?

  isRead    Boolean          @default(false)
  readAt    DateTime?

  createdAt DateTime         @default(now())

  user      User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor     User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

// =============================================================================
// INTERVENTION
// =============================================================================
// A manual log a manager/lead can attach to a task or bug when they had to
// step in — clarify requirements, redo part of the work themselves, chase
// progress, etc. Feeds the "micromanagement / intervention" signal on the
// employee performance pages. Intentionally simple: just a note, no category.

model Intervention {
  id         String   @id @default(uuid())
  taskId     String?
  bugId      String?
  employeeId String   // who the intervention was about
  managerId  String   // who logged it

  note       String

  createdAt  DateTime @default(now())

  task       Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  bug        Bug?     @relation(fields: [bugId], references: [id], onDelete: Cascade)
  employee   User     @relation("InterventionEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  manager    User     @relation("InterventionManager", fields: [managerId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([bugId])
  @@index([employeeId])
  @@index([createdAt])
  @@map("interventions")
}

// =============================================================================
// DAILY WORK UPDATE
// =============================================================================

model DailyWorkUpdate {
  id             String   @id @default(uuid())
  userId         String
  date           DateTime @db.Date  // The work date (no time)

  summary        String             // Narrative of what was worked on
  hoursWorked    Float
  tomorrowPlan   String?
  blockers       String?
  mood           Int?               // Optional 1-5 morale indicator

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Many-to-many with tasks
  tasks          DailyWorkUpdateTask[]
  // Many-to-many with projects
  projects       DailyWorkUpdateProject[]
  // Leadership replies
  replies        DailyWorkUpdateReply[]

  @@unique([userId, date])            // One update per user per day
  @@index([userId])
  @@index([date])
  @@map("daily_work_updates")
}

// Join table: DailyWorkUpdate ↔ Task (with context)
model DailyWorkUpdateTask {
  id            String          @id @default(uuid())
  updateId      String
  taskId        String
  isCompleted   Boolean         @default(false) // Did they finish it today?
  isBlocked     Boolean         @default(false) // Is it blocked?
  hoursSpent    Float?
  notes         String?

  update        DailyWorkUpdate @relation(fields: [updateId], references: [id], onDelete: Cascade)
  task          Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([updateId, taskId])
  @@index([updateId])
  @@index([taskId])
  @@map("daily_work_update_tasks")
}

// =============================================================================
// BUG TRACKER
// =============================================================================

model Bug {
  id                String       @id @default(uuid())
  title             String
  description       String?
  stepsToReproduce  String?
  expectedBehavior  String?
  actualBehavior    String?
  environment       String?      // e.g. "Chrome 120, macOS 14"

  status            BugStatus    @default(OPEN)
  severity          BugSeverity  @default(MEDIUM)
  priority          TaskPriority @default(MEDIUM)
  platform          BugPlatform?

  projectId         String?
  assigneeId        String?
  reporterId        String
  linkedTaskId      String?      // Task this bug was converted to / linked with

  resolvedAt        DateTime?
  closedAt          DateTime?
  isArchived        Boolean      @default(false)

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  project           Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assignee          User?        @relation("BugAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporter          User         @relation("BugReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  linkedTask        Task?        @relation("BugLinkedTask", fields: [linkedTaskId], references: [id], onDelete: SetNull)
  comments          Comment[]
  history           BugHistory[]
  interventions     Intervention[]

  @@index([projectId])
  @@index([assigneeId])
  @@index([reporterId])
  @@index([status])
  @@index([severity])
  @@index([priority])
  @@index([platform])
  @@index([linkedTaskId])
  @@index([isArchived])
  @@index([createdAt])
  @@map("bugs")
}

// Join table: DailyWorkUpdate ↔ Project
model DailyWorkUpdateProject {
  id        String          @id @default(uuid())
  updateId  String
  projectId String

  update    DailyWorkUpdate @relation(fields: [updateId], references: [id], onDelete: Cascade)
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([updateId, projectId])
  @@index([updateId])
  @@index([projectId])
  @@map("daily_work_update_projects")
}

// =============================================================================
// MEETINGS / MOM (Minutes of Meeting)
// =============================================================================

enum MeetingType {
  STANDUP
  SPRINT_PLANNING
  SPRINT_REVIEW
  CLIENT_MEETING
  TECHNICAL_DISCUSSION
  RCA
  GENERAL
}

enum ActionItemStatus {
  OPEN
  IN_PROGRESS
  DONE
  CONVERTED // has a linked Task — see MeetingActionItem.taskId
}

model Meeting {
  id          String      @id @default(uuid())
  projectId   String
  title       String
  type        MeetingType @default(GENERAL)
  scheduledAt DateTime
  duration    Int?        // minutes
  organizerId String?
  description String?     // agenda

  // MOM editor — filled in after the meeting happens
  momSummary       String?
  discussionPoints String?
  decisionsMade    String?
  risksBlockers    String?
  additionalNotes  String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project      Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organizer    User?                @relation("MeetingOrganizer", fields: [organizerId], references: [id], onDelete: SetNull)
  participants MeetingParticipant[]
  actionItems  MeetingActionItem[]

  @@index([projectId])
  @@index([scheduledAt])
  @@map("meetings")
}

model MeetingParticipant {
  meetingId String
  userId    String

  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([meetingId, userId])
  @@index([userId])
  @@map("meeting_participants")
}

model MeetingActionItem {
  id          String            @id @default(uuid())
  meetingId   String
  title       String
  description String?
  assigneeId  String?
  priority    TaskPriority      @default(MEDIUM)
  dueDate     DateTime?
  status      ActionItemStatus  @default(OPEN)
  taskId      String?           @unique // set once converted to a Task

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  meeting     Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  assignee    User?     @relation("ActionItemAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  task        Task?     @relation("ActionItemTask", fields: [taskId], references: [id], onDelete: SetNull)
  comments    Comment[]

  @@index([meetingId])
  @@index([assigneeId])
  @@map("meeting_action_items")
}

// A reply on a daily work update — written by leadership (Admin/Manager/PM),
// or by the update's author replying back.
model DailyWorkUpdateReply {
  id            String   @id @default(uuid())
  dailyUpdateId String
  authorId      String
  content       String
  createdAt     DateTime @default(now())

  dailyUpdate   DailyWorkUpdate @relation(fields: [dailyUpdateId], references: [id], onDelete: Cascade)
  author        User            @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([dailyUpdateId])
  @@index([authorId])
  @@map("daily_work_update_replies")
}
